# Copy this file to .env and fill in real values - .env itself is gitignored and must
# never be committed. Used both by docker-compose.yml (env_file: .env, for both the app
# and db services) and by a plain local `uv run uvicorn` dev run.

# --- db service (postgres:16-alpine) --------------------------------------------------
# Must match the credentials/dbname encoded in DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ranobelib_companion

# --- app service (see app/config.py for the full description of each) -----------------

# Set to "production" for a real deploy - requires SESSION_SECRET_KEY below and adds the
# Secure flag to the session cookie. Leave unset (or anything else) for local dev.
ENVIRONMENT=development

# Signs the session cookie. Must stay stable across restarts, or every visitor gets
# logged out on each deploy. Required (app refuses to start without it) when
# ENVIRONMENT=production. Generate one with e.g. `openssl rand -hex 32`.
SESSION_SECRET_KEY=change-me

# The app's own Postgres database (accounts, personal library, activity) - `db` is this
# compose file's own postgres service, not localhost.
DATABASE_URL=postgresql://postgres:change-me@db:5432/ranobelib_companion

# SDK's public response cache (title/chapter data), shared across all users.
CACHE_DIR=.ranobelib_cache
CACHE_TTL_SECONDS=21600

# Uploaded profile avatars.
AVATAR_DIR=.ranobelib_avatars

# Converted comment attachments (GIF -> silent looping mp4).
COMMENT_ATTACHMENT_DIR=.ranobelib_comment_attachments

# Session cookie lifetimes, in seconds.
SESSION_MAX_AGE_SECONDS=1209600
SESSION_REMEMBER_MAX_AGE_SECONDS=7776000

# Fallback cleanup window for an exported title's file, in seconds.
DOWNLOAD_FILE_TTL_SECONDS=1800
